# Application Settings
APP_NAME=智能客服系统
APP_VERSION=1.0.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# MySQL Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=customer_service

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# LLM API (默认使用模拟模式，配置后可对接真实API)
LLM_API_BASE=http://localhost:8001
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# Milvus Vector Database (向量数据库，Docker部署后可用)
MILVUS_HOST=localhost
MILVUS_PORT=19530
USE_MILVUS=true

# Embedding API (留空则使用本地模拟；填好后自动启用真实模型)
# 推荐支持 OpenAI 兼容格式的服务：DashScope(text-embedding-v3) / 智谱(embedding-3) / 自建
# 示例：
#   DashScope:  EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
#               EMBEDDING_MODEL=text-embedding-v3
#               EMBEDDING_DIM=1024
#   智谱AI:    EMBEDDING_API_BASE=https://open.bigmodel.cn/api/paas/v4
#               EMBEDDING_MODEL=embedding-3
#               EMBEDDING_DIM=1024
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024
