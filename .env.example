# Application Settings
APP_NAME=智能客服系统
APP_VERSION=1.0.0
DEBUG=true

# 数据库配置 - 使用MySQL (Docker容器)
# DATABASE_URL_OVERRIDE=sqlite+aiosqlite:///./customer_service.db

# MySQL Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=customer_service

# Redis Cache (可选，未启用时系统会跳过)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# LLM API (默认使用模拟模式，配置后可对接真实API)
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-ws-H.EPMIPMI.iFNQ.MEQCIE7UsHzW7vBm2UPUeIxmc-MGHp_TvN66f5VDNULVwbsgAiAYJkrumS5CPr36V4ZaYBTBJh68qYUyEH0kSGwMS148qw
LLM_MODEL=qwen3.6-plus

# Milvus Vector Database (向量数据库，Docker部署后可用)
MILVUS_HOST=localhost
MILVUS_PORT=19531
USE_MILVUS=true

# Embedding API (留空则使用本地模拟；填好后自动启用真实模型)
# 推荐支持 OpenAI 兼容格式的服务：DashScope(text-embedding-v3) / 智谱(embedding-3) / 自建
# 示例：
#   DashScope:  EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
#               EMBEDDING_MODEL=text-embedding-v3
#               EMBEDDING_DIM=1024
#   智谱AI:    EMBEDDING_API_BASE=https://open.bigmodel.cn/api/paas/v4
#               EMBEDDING_MODEL=embedding-3
#               EMBEDDING_DIM=1024
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-ws-H.EPMIPMI.iFNQ.MEQCIE7UsHzW7vBm2UPUeIxmc-MGHp_TvN66f5VDNULVwbsgAiAYJkrumS5CPr36V4ZaYBTBJh68qYUyEH0kSGwMS148qw
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# RAG 检索增强生成配置
COLLECTION_NAME=customer_service_knowledge
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.2
RAG_BM25_WEIGHT=0.5
RAG_VECTOR_WEIGHT=0.5
RAG_USE_RERANKER=true
RAG_SEARCH_TOP_K_MULTIPLIER=3

# 文档分块配置
# split_pattern 可选: sentence(按句子) / paragraph(按段落) / fixed(固定长度)
CHUNK_SIZE=500
CHUNK_OVERLAP=50
CHUNK_SPLIT_PATTERN=sentence